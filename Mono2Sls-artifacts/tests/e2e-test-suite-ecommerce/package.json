{
  "name": "m2s-e2e-ecommerce",
  "version": "1.0.0",
  "description": "Contract-based E2E suite for ecommerce serverless migration evaluation",
  "scripts": {
    "test": "jest --runInBand --forceExit",
    "test:target": "node run-target.js",
    "test:m2s-dsv3-ecommerce": "node run-target.js m2s_dsv3_ecommerce",
    "test:m2s-sonnet46-ecommerce": "node run-target.js m2s_sonnet46_ecommerce",
    "test:cursor-ecommerce": "node run-target.js cursor_sonnet45tk_ecommerce",
    "test:claudecode-ecommerce": "node run-target.js claudecode_sonnet46_ecommerce",
    "test:all": "node run-all.js",
    "test:report": "node generate-report.js",
    "seed:state": "node seed-ecommerce-state.js"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.882.0",
    "@aws-sdk/client-dynamodb": "^3.882.0",
    "@aws-sdk/lib-dynamodb": "^3.882.0",
    "axios": "^1.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
