{
  "configType": "normalized_business_contract",
  "_description": "Normalized contract for cross-target ecommerce E2E. Semantic paths intentionally omit the optional /api prefix so pathPrefix can adapt different deployments.",
  "businessEndpoints": [
    {
      "id": "TC-01",
      "method": "GET",
      "semanticPath": "/products",
      "response": {
        "successStatus": 200,
        "listLocation": ["products"],
        "requiredItemFields": ["productId", "name", "category", "price", "package"]
      }
    },
    {
      "id": "TC-02",
      "method": "GET",
      "semanticPath": "/products/{product_id}",
      "response": {
        "successStatus": 200,
        "objectLocation": ["product"],
        "requiredFields": ["productId", "name", "category", "price", "package"]
      }
    },
    {
      "id": "TC-03",
      "method": "GET",
      "semanticPath": "/products/category/{category}",
      "response": {
        "successStatus": 200,
        "listLocation": ["products"],
        "requiredItemFields": ["productId", "name", "category", "price", "package"]
      }
    },
    {
      "id": "TC-04",
      "method": "POST",
      "semanticPath": "/payment-3p/preauth",
      "response": {
        "successStatus": 200,
        "objectLocation": ["$"]
      }
    },
    {
      "id": "TC-05",
      "method": "POST",
      "semanticPath": "/payment-3p/check",
      "response": {
        "successStatus": 200,
        "objectLocation": ["$"]
      }
    },
    {
      "id": "TC-06",
      "method": "POST",
      "semanticPath": "/orders/delivery-pricing",
      "response": {
        "successStatus": 200,
        "objectLocation": ["$"]
      }
    },
    {
      "id": "TC-07",
      "method": "POST",
      "semanticPath": "/orders",
      "response": {
        "successStatus": 201,
        "objectLocation": ["order", "$"],
        "requiredOrderFields": ["orderId", "userId", "status", "products", "deliveryPrice", "total", "paymentToken"]
      }
    },
    {
      "id": "TC-08",
      "method": "GET",
      "semanticPath": "/orders/{order_id}",
      "response": {
        "successStatus": 200,
        "objectLocation": ["order", "$.order"],
        "requiredOrderFields": ["orderId", "userId", "status", "products", "deliveryPrice", "total", "paymentToken"]
      }
    },
    {
      "id": "TC-09",
      "method": "GET",
      "semanticPath": "/orders",
      "response": {
        "successStatus": 200,
        "listLocation": ["orders"]
      }
    },
    {
      "id": "TC-10",
      "method": "PUT",
      "semanticPath": "/orders/{order_id}",
      "response": {
        "successStatus": 200,
        "objectLocation": ["$"]
      }
    },
    {
      "id": "TC-11",
      "method": "DELETE",
      "semanticPath": "/orders/{order_id}",
      "response": {
        "successStatus": 200,
        "objectLocation": ["$"]
      }
    },
    {
      "id": "TC-12",
      "method": "GET",
      "semanticPath": "/warehouse/packaging-requests",
      "response": {
        "successStatus": 200,
        "listLocation": ["packagingRequestIds", "requests"]
      }
    },
    {
      "id": "TC-13",
      "method": "GET",
      "semanticPath": "/warehouse/packaging-requests/{order_id}",
      "response": {
        "successStatus": 200,
        "objectLocation": ["packagingRequest"],
        "requiredPackagingFields": ["orderId", "status", "products"]
      }
    },
    {
      "id": "TC-14",
      "method": "POST",
      "semanticPath": "/warehouse/packaging-requests/{order_id}/start",
      "response": {
        "successStatus": 200,
        "objectLocation": ["$"]
      }
    },
    {
      "id": "TC-15",
      "method": "PUT",
      "semanticPath": "/warehouse/packaging-requests/{order_id}/products",
      "response": {
        "successStatus": 200,
        "objectLocation": ["$"]
      }
    },
    {
      "id": "TC-16",
      "method": "POST",
      "semanticPath": "/warehouse/packaging-requests/{order_id}/complete",
      "response": {
        "successStatus": 200,
        "objectLocation": ["$"]
      }
    },
    {
      "id": "TC-17",
      "method": "POST",
      "semanticPath": "/warehouse/packaging-requests/{order_id}/fail",
      "response": {
        "successStatus": 200,
        "objectLocation": ["$"]
      }
    },
    {
      "id": "TC-18",
      "method": "GET",
      "semanticPath": "/delivery/deliveries",
      "response": {
        "successStatus": 200,
        "listLocation": ["deliveries"]
      }
    },
    {
      "id": "TC-19",
      "method": "GET",
      "semanticPath": "/delivery/deliveries/{order_id}",
      "response": {
        "successStatus": 200,
        "objectLocation": ["delivery"],
        "requiredDeliveryFields": ["orderId", "status", "address"]
      }
    },
    {
      "id": "TC-20",
      "method": "POST",
      "semanticPath": "/delivery/deliveries/{order_id}/start",
      "response": {
        "successStatus": 200,
        "objectLocation": ["$"]
      }
    },
    {
      "id": "TC-21",
      "method": "POST",
      "semanticPath": "/delivery/deliveries/{order_id}/complete",
      "response": {
        "successStatus": 200,
        "objectLocation": ["$"]
      }
    },
    {
      "id": "TC-22",
      "method": "POST",
      "semanticPath": "/delivery/deliveries/{order_id}/fail",
      "response": {
        "successStatus": 200,
        "objectLocation": ["$"]
      }
    },
    {
      "id": "TC-23",
      "method": "POST",
      "semanticPath": "/payment/validate",
      "response": {
        "successStatus": 200,
        "objectLocation": ["$"]
      }
    },
    {
      "id": "TC-24",
      "method": "POST",
      "semanticPath": "/payment-3p/processPayment",
      "response": {
        "successStatus": 200,
        "objectLocation": ["$"]
      }
    },
    {
      "id": "TC-25",
      "method": "POST",
      "semanticPath": "/payment-3p/cancelPayment",
      "response": {
        "successStatus": 200,
        "objectLocation": ["$"]
      }
    },
    {
      "id": "TC-26",
      "method": "POST",
      "semanticPath": "/payment-3p/updateAmount",
      "response": {
        "successStatus": 200,
        "objectLocation": ["$"]
      }
    }
  ],
  "authCompatibilityEndpoints": [
    {
      "id": "AUTH-01",
      "method": "POST",
      "semanticPath": "/auth/register"
    },
    {
      "id": "AUTH-02",
      "method": "POST",
      "semanticPath": "/auth/login"
    },
    {
      "id": "AUTH-03",
      "method": "GET",
      "semanticPath": "/auth/me"
    }
  ],
  "antiPatternEndpoints": [
    {
      "method": "POST",
      "semanticPath": "/auth/register"
    },
    {
      "method": "POST",
      "semanticPath": "/auth/login"
    },
    {
      "method": "GET",
      "semanticPath": "/auth/me"
    },
    {
      "method": "POST",
      "semanticPath": "/auth/refresh"
    }
  ],
