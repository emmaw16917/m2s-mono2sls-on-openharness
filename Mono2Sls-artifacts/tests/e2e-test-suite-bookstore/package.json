{
  "name": "m2s-e2e-bookstore",
  "version": "1.0.0",
  "description": "Contract-based E2E suite for bookstore serverless migration evaluation",
  "scripts": {
    "test": "jest --runInBand --forceExit",
    "test:target": "node run-target.js",
    "test:m2s-dsv3-bookstore": "node run-target.js m2s_dsv3_bookstore",
    "test:m2s-sonnet46-bookstore": "node run-target.js m2s_sonnet46_bookstore",
    "test:cursor-bookstore": "node run-target.js cursor_sonnet45tk_bookstore",
    "test:claudecode-bookstore": "node run-target.js claudecode_sonnet46_bookstore",
    "test:all": "node run-all.js",
    "test:report": "node generate-report.js",
    "seed:catalog": "node seed-catalog.js",
    "reset:state": "node reset-bookstore-state.js"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.600.0",
    "@aws-sdk/client-dynamodb": "^3.1008.0",
    "axios": "^1.7.0",
    "cognito-srp-helper": "^2.3.5"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
