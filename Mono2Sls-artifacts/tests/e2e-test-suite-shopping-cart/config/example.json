{
  "_comment": "Template for a target config file. Copy to e.g. my_target_shopping_cart.json and fill in the values after deploying your SAM project.",
  "configType": "target",
  "name": "My Target - Shopping Cart",
  "shortName": "my_target_shopping_cart",
  "baseUrl": "https://YOUR_API_ID.execute-api.YOUR_REGION.amazonaws.com/YOUR_STAGE",
  "pathPrefix": "",
  "artifactTemplate": "../results/YOUR_VARIANT/shopping-cart/output/template.yaml",
  "authType": "cognito",
  "tableName": "YOUR-STACK-NAME-shopping-cart",
  "authConfig": {
    "userPoolId": "YOUR_REGION_XXXXXXXXX",
    "clientId": "YOUR_APP_CLIENT_ID",
    "region": "YOUR_REGION",
    "userEmailDomain": "example.com",
    "defaultPassword": "TestPass123!"
  },
  "capabilities": {
    "dropsMonolithAuthEndpoints": false
  },
  "timeouts": {
    "requestTimeoutMs": 30000,
    "eventualConsistencyTimeoutMs": 30000,
    "pollIntervalMs": 2000
  }
