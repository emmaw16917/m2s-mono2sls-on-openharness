new file mode 100644
index 0000000..cce4dca
--- /dev/null
+++ b/tests/test_config/test_cli_settings_flags.py
@@ -0,0 +1,158 @@
+"""--settings / --allowed-tools / --disallowed-tools / --mcp-config overlay."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from openharness.config import load_settings, save_settings
+from openharness.config.cli_overlay import SettingsFlags
+from openharness.config.settings import SettingsOverlay, apply_json_merge_patch
+from openharness.mcp.types import McpHttpServerConfig, McpStdioServerConfig
+
+
+@pytest.fixture
+def config_dir(tmp_path: Path, monkeypatch) -> Path:
+    path = tmp_path / "config"
+    path.mkdir()
+    monkeypatch.setenv("OPENHARNESS_CONFIG_DIR", str(path))
+    return path
+
+
+def _write_settings(config_dir: Path, data: dict) -> Path:
+    settings_path = config_dir / "settings.json"
+    settings_path.write_text(json.dumps(data), encoding="utf-8")
+    return settings_path
+
+
+def test_json_merge_patch_merges_objects_removes_nulls_replaces_lists():
+    target = {"a": {"b": 1, "c": 2}, "lst": [1, 2], "gone": True}
+    patch = {"a": {"c": 3, "d": 4}, "lst": [9], "gone": None, "new": "x"}
+
+    result = apply_json_merge_patch(target, patch)
+
+    assert result == {"a": {"b": 1, "c": 3, "d": 4}, "lst": [9], "new": "x"}
+    assert target == {"a": {"b": 1, "c": 2}, "lst": [1, 2], "gone": True}
+
+
+def test_overlay_layers_over_settings_file(config_dir: Path):
+    _write_settings(
+        config_dir,
+        {
+            "permission": {"mode": "full_auto", "denied_tools": ["web_fetch"]},
+            "mcp_servers": {
+                "m2s": {"type": "stdio", "command": "python", "args": ["server.py"], "env": {"WS": "a"}},
+                "other": {"type": "stdio", "command": "other"},
+            },
+        },
+    )
+    overlay = SettingsOverlay(
+        patch={
+            "permission": {
+                "path_rules": [{"pattern": "*/coord/*", "allow": False}],
+                "denied_commands": ["*coord*"],
+            },
+            "mcp_servers": {"other": None},
+        },
+        allowed_tools=("read_file",),
+        denied_tools=("bash", "web_fetch"),
+        mcp_servers={"m2s": McpHttpServerConfig(url="http://127.0.0.1:9/mcp/")},
+    )
+
+    settings = load_settings(overlay=overlay)
+
+    assert settings.permission.mode.value == "full_auto"
+    assert [rule.pattern for rule in settings.permission.path_rules] == ["*/coord/*"]
+    assert settings.permission.path_rules[0].allow is False
+    assert settings.permission.denied_commands == ["*coord*"]
+    assert settings.permission.allowed_tools == ["read_file"]
+    assert settings.permission.denied_tools == ["web_fetch", "bash"]
+    # --mcp-config replaces a same-name server outright; null in --settings removes one.
+    assert set(settings.mcp_servers) == {"m2s"}
+    assert isinstance(settings.mcp_servers["m2s"], McpHttpServerConfig)
+
+
+def test_overlay_without_settings_file(config_dir: Path):
+    settings = load_settings(overlay=SettingsOverlay(patch={"max_turns": 7}))
+
+    assert settings.max_turns == 7
+    assert not (config_dir / "settings.json").exists()
+
+
+def test_overlay_is_never_persisted(config_dir: Path):
+    settings_path = _write_settings(config_dir, {"max_turns": 50})
+    overlay = SettingsOverlay(patch={"max_turns": 7}, denied_tools=("bash",))
+
+    assert load_settings(overlay=overlay).max_turns == 7
+    save_settings(load_settings())
+
+    on_disk = json.loads(settings_path.read_text(encoding="utf-8"))
+    assert on_disk["max_turns"] == 50
+    assert "bash" not in on_disk["permission"]["denied_tools"]
+    assert load_settings().max_turns == 50
+
+
+def test_empty_overlay_matches_plain_load(config_dir: Path):
+    _write_settings(config_dir, {"max_turns": 50, "permission": {"denied_tools": ["bash"]}})
+
+    assert load_settings(overlay=SettingsOverlay()) == load_settings()
+
+
+def test_flags_parse_inline_json_and_split_tool_names():
+    flags = SettingsFlags.from_cli(
+        settings='{"permission": {"denied_commands": ["*secret*"]}}',
+        allowed_tools=["read_file, grep", "glob"],
+        disallowed_tools=["bash web_fetch", "bash"],
+        mcp_config=['{"mcpServers": {"s": {"command": "node", "args": ["s.js"]}}}'],
+    )
+
+    overlay = flags.to_overlay()
+
+    assert overlay.patch == {"permission": {"denied_commands": ["*secret*"]}}
+    assert overlay.allowed_tools == ("read_file", "grep", "glob")
+    assert overlay.denied_tools == ("bash", "web_fetch")
+    assert isinstance(overlay.mcp_servers["s"], McpStdioServerConfig)
+    assert overlay.mcp_servers["s"].args == ["s.js"]
+
+
+def test_flags_resolve_relative_paths(tmp_path: Path, monkeypatch):
+    (tmp_path / "worker.json").write_text('{"max_turns": 3}', encoding="utf-8")
+    (tmp_path / "mcp.json").write_text(
+        '{"mcp_servers": {"h": {"type": "http", "url": "http://127.0.0.1:1/mcp/"}}}', encoding="utf-8"
+    )
+    monkeypatch.chdir(tmp_path)
+
+    flags = SettingsFlags.from_cli(settings="worker.json", mcp_config=["mcp.json"])
+
+    assert flags.settings == str((tmp_path / "worker.json").resolve())
+    assert flags.mcp_config == (str((tmp_path / "mcp.json").resolve()),)
+    overlay = flags.to_overlay()
+    assert overlay.patch == {"max_turns": 3}
+    assert isinstance(overlay.mcp_servers["h"], McpHttpServerConfig)
+
+
+@pytest.mark.parametrize(
+    ("kwargs", "message"),
+    [
+        ({"settings": "{not json"}, "--settings: invalid JSON"),
+        ({"settings": "[1, 2]"}, "--settings: cannot read"),
+        ({"settings": '{"max_turns": "many"}'}, "--settings: invalid settings"),
+        ({"settings": "missing-file.json"}, "--settings: cannot read"),
+        ({"mcp_config": ['{"servers": {}}']}, "--mcp-config: expected an object with an 'mcpServers' object"),
+        ({"mcp_config": ['{"mcpServers": {"x": {"type": "http"}}}']}, "--mcp-config: invalid server 'x'"),
+    ],
+)
+def test_flags_report_errors_with_flag_name(tmp_path: Path, monkeypatch, kwargs, message):
+    monkeypatch.chdir(tmp_path)
+
+    with pytest.raises(ValueError, match=message.replace("[", r"\[")):
+        SettingsFlags.from_cli(**kwargs).to_overlay()
+
+
+def test_empty_flags():
+    flags = SettingsFlags.from_cli(settings="  ", allowed_tools=[" , "], mcp_config=[])
+
+    assert flags.is_empty()
+    assert flags.to_overlay().is_empty()
