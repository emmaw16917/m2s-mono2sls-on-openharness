@@ -0,0 +1,198 @@
+"""Settings overlay, --append-system-prompt and --permission-mode reach the runtime."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+from typer.testing import CliRunner
+
+import openharness.cli as cli
+from openharness.config.cli_overlay import SettingsFlags
+from openharness.config.settings import SettingsOverlay
+from openharness.ui import app as ui_app
+from openharness.ui.react_launcher import build_backend_command
+from openharness.ui.runtime import build_runtime, close_runtime, refresh_runtime_client
+
+
+class _StaticApiClient:
+    async def stream_message(self, request):
+        del request
+        if False:
+            yield None
+
+
+@pytest.fixture
+def isolated_dirs(tmp_path: Path, monkeypatch) -> Path:
+    monkeypatch.setenv("OPENHARNESS_CONFIG_DIR", str(tmp_path / "config"))
+    monkeypatch.setenv("OPENHARNESS_DATA_DIR", str(tmp_path / "data"))
+    monkeypatch.setenv("OPENHARNESS_LOGS_DIR", str(tmp_path / "logs"))
+    return tmp_path
+
+
+def _worker_overlay() -> SettingsOverlay:
+    return SettingsOverlay(
+        patch={
+            "permission": {
+                "mode": "full_auto",
+                "path_rules": [{"pattern": "*/protected/*", "allow": False}],
+                "denied_commands": ["*protected*"],
+            }
+        },
+        denied_tools=("web_fetch",),
+    )
+
+
+@pytest.mark.asyncio
+async def test_build_runtime_applies_overlay_and_keeps_it_on_refresh(isolated_dirs: Path):
+    bundle = await build_runtime(
+        cwd=str(isolated_dirs),
+        api_client=_StaticApiClient(),
+        settings_overlay=_worker_overlay(),
+        append_system_prompt="ROLE: m2s-code-developer",
+    )
+    try:
+        for _ in range(2):  # before and after a runtime refresh
+            checker = bundle.engine._permission_checker
+            assert not checker.evaluate("read_file", is_read_only=True, file_path="/ws/protected/x.json").allowed
+            assert not checker.evaluate("bash", is_read_only=False, command="cat protected/x.json").allowed
+            assert not checker.evaluate("web_fetch", is_read_only=True).allowed
+            assert checker.evaluate("read_file", is_read_only=True, file_path="/ws/output/x.js").allowed
+            assert bundle.engine.system_prompt.rstrip().endswith("ROLE: m2s-code-developer")
+            assert bundle.current_settings().permission.mode.value == "full_auto"
+            refresh_runtime_client(bundle)
+    finally:
+        await close_runtime(bundle)
+
+
+@pytest.mark.asyncio
+async def test_append_system_prompt_keeps_base_prompt(isolated_dirs: Path):
+    plain = await build_runtime(cwd=str(isolated_dirs), api_client=_StaticApiClient())
+    appended = await build_runtime(
+        cwd=str(isolated_dirs), api_client=_StaticApiClient(), append_system_prompt="EXTRA RULES"
+    )
+    try:
+        assert appended.engine.system_prompt.startswith(plain.engine.system_prompt[:200])
+        assert "EXTRA RULES" not in plain.engine.system_prompt
+    finally:
+        await close_runtime(plain)
+        await close_runtime(appended)
+
+
+class _StopAfterBuild(Exception):
+    pass
+
+
+@pytest.mark.asyncio
+async def test_print_mode_forwards_permission_mode_append_and_overlay(isolated_dirs: Path, monkeypatch):
+    captured: dict = {}
+
+    async def spy_build_runtime(**kwargs):
+        captured.update(kwargs)
+        raise _StopAfterBuild
+
+    monkeypatch.setattr(ui_app, "build_runtime", spy_build_runtime)
+    overlay = _worker_overlay()
+
+    with pytest.raises(_StopAfterBuild):
+        await ui_app.run_print_mode(
+            prompt="hello",
+            cwd=str(isolated_dirs),
+            api_client=_StaticApiClient(),
+            permission_mode="plan",
+            append_system_prompt="ROLE: verifier",
+            settings_overlay=overlay,
+            max_turns=1,
+        )
+
+    assert captured["permission_mode"] == "plan"
+    assert captured["append_system_prompt"] == "ROLE: verifier"
+    assert captured["settings_overlay"] is overlay
+
+
+def test_cli_print_mode_passes_parsed_flags(isolated_dirs: Path, monkeypatch):
+    captured: dict = {}
+
+    async def fake_run_print_mode(**kwargs):
+        captured.update(kwargs)
+
+    monkeypatch.setattr("openharness.ui.app.run_print_mode", fake_run_print_mode)
+    settings_file = isolated_dirs / "worker.json"
+    settings_file.write_text(json.dumps({"permission": {"denied_commands": ["*coord*"]}}), encoding="utf-8")
+
+    result = CliRunner().invoke(
+        cli.app,
+        [
+            "-p", "do the task",
+            "--settings", str(settings_file),
+            "--allowed-tools", "read_file,grep",
+            "--disallowed-tools", "bash",
+            "--mcp-config", '{"mcpServers": {"m2s": {"command": "python", "args": ["server.py"]}}}',
+            "--append-system-prompt", "ROLE: architect",
+            "--permission-mode", "full_auto",
+        ],
+    )
+
+    assert result.exit_code == 0, result.output
+    overlay = captured["settings_overlay"]
+    assert overlay.patch == {"permission": {"denied_commands": ["*coord*"]}}
+    assert overlay.allowed_tools == ("read_file", "grep")
+    assert overlay.denied_tools == ("bash",)
+    assert set(overlay.mcp_servers) == {"m2s"}
+    assert captured["append_system_prompt"] == "ROLE: architect"
+    assert captured["permission_mode"] == "full_auto"
+
+
+def test_cli_rejects_bad_settings_before_starting(isolated_dirs: Path, monkeypatch):
+    async def fail_run_print_mode(**kwargs):  # pragma: no cover - must not run
+        raise AssertionError("print mode started with invalid --settings")
+
+    monkeypatch.setattr("openharness.ui.app.run_print_mode", fail_run_print_mode)
+
+    result = CliRunner().invoke(cli.app, ["-p", "x", "--settings", "{broken"])
+
+    assert result.exit_code == 1
+    assert "--settings: invalid JSON" in result.output
+
+
+def test_cli_dry_run_shows_overlay(isolated_dirs: Path, monkeypatch):
+    monkeypatch.chdir(isolated_dirs)
+
+    result = CliRunner().invoke(
+        cli.app,
+        [
+            "--dry-run", "-p", "preview", "--output-format", "json",
+            "--settings", '{"permission": {"path_rules": [{"pattern": "*/coord/*", "allow": false}]}}',
+            "--disallowed-tools", "bash",
+            "--mcp-config", '{"mcpServers": {"m2s": {"command": "python", "args": ["server.py"]}}}',
+            "--append-system-prompt", "ROLE: verifier",
+        ],
+    )
+
+    assert result.exit_code == 0, result.output
+    preview = json.loads(result.output)
+    rules = preview["settings"]["permission_rules"]
+    assert rules["denied_tools"] == ["bash"]
+    assert rules["path_rules"] == [{"pattern": "*/coord/*", "allow": False}]
+    assert [entry["name"] for entry in preview["mcp_servers"]] == ["m2s"]
+
+
+def test_backend_command_forwards_flags():
+    command = build_backend_command(
+        cwd="/ws",
+        append_system_prompt="ROLE",
+        settings='{"max_turns": 3}',
+        allowed_tools=["read_file"],
+        disallowed_tools=["bash", "web_fetch"],
+        mcp_config=["/abs/mcp.json"],
+    )
+
+    assert command[command.index("--append-system-prompt") + 1] == "ROLE"
+    assert command[command.index("--settings") + 1] == '{"max_turns": 3}'
+    assert command.count("--disallowed-tools") == 2
+    assert command[command.index("--mcp-config") + 1] == "/abs/mcp.json"
+    reparsed = SettingsFlags.from_cli(
+        settings='{"max_turns": 3}', allowed_tools=["read_file"], disallowed_tools=["bash", "web_fetch"]
+    )
+    assert reparsed.to_overlay().denied_tools == ("bash", "web_fetch")
