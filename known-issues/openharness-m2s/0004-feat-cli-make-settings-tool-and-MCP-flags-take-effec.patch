diff --git a/src/openharness/config/cli_overlay.py b/src/openharness/config/cli_overlay.py
new file mode 100644
index 0000000..806f273
--- /dev/null
+++ b/src/openharness/config/cli_overlay.py
@@ -0,0 +1,129 @@
+"""Parse the settings-related CLI flags into a SettingsOverlay.
+
+``--settings``      inline JSON object or path to a JSON file; applied as a
+                    JSON Merge Patch over settings.json (``null`` removes a key)
+``--allowed-tools`` tool names added to ``permission.allowed_tools``
+``--disallowed-tools`` tool names added to ``permission.denied_tools``
+``--mcp-config``    inline JSON or path; ``{"mcpServers": {...}}`` (Claude Code
+                    shape) or ``{"mcp_servers": {...}}``; adds servers and
+                    replaces same-name ones from settings.json
+
+Tool flags may be repeated and each value may list several names separated by
+commas or whitespace. File paths are resolved against the process working
+directory when the flags are parsed, so the raw values can be forwarded to a
+child process (the React backend host) unchanged.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+from pydantic import TypeAdapter, ValidationError
+
+from openharness.config.settings import Settings, SettingsOverlay, apply_json_merge_patch
+from openharness.mcp.types import McpServerConfig
+
+_MCP_SERVER_ADAPTER: TypeAdapter[McpServerConfig] = TypeAdapter(McpServerConfig)
+
+
+def _is_inline_json(value: str) -> bool:
+    return value.lstrip().startswith("{")
+
+
+def _normalize_source(value: str) -> str:
+    """Inline JSON is kept as is; a path becomes absolute."""
+    if _is_inline_json(value):
+        return value
+    return str(Path(value.strip()).expanduser().resolve())
+
+
+def _load_json_object(value: str, flag: str) -> dict[str, Any]:
+    if _is_inline_json(value):
+        source = "inline JSON"
+        text = value
+    else:
+        path = Path(value.strip()).expanduser()
+        source = str(path)
+        try:
+            text = path.read_text(encoding="utf-8")
+        except OSError as exc:
+            raise ValueError(f"{flag}: cannot read {source}: {exc}") from exc
+    try:
+        data = json.loads(text)
+    except json.JSONDecodeError as exc:
+        raise ValueError(f"{flag}: invalid JSON in {source}: {exc}") from exc
+    if not isinstance(data, dict):
+        raise ValueError(f"{flag}: {source} must contain a JSON object")
+    return data
+
+
+def _split_tool_names(values: list[str] | tuple[str, ...] | None) -> tuple[str, ...]:
+    names: list[str] = []
+    for value in values or ():
+        names.extend(part for part in re.split(r"[,\s]+", value) if part)
+    return tuple(dict.fromkeys(names))
+
+
+@dataclass(frozen=True)
+class SettingsFlags:
+    """Raw values of the settings-related CLI flags, normalized for forwarding."""
+
+    settings: str | None = None
+    allowed_tools: tuple[str, ...] = ()
+    disallowed_tools: tuple[str, ...] = ()
+    mcp_config: tuple[str, ...] = ()
+
+    @classmethod
+    def from_cli(
+        cls,
+        *,
+        settings: str | None = None,
+        allowed_tools: list[str] | None = None,
+        disallowed_tools: list[str] | None = None,
+        mcp_config: list[str] | None = None,
+    ) -> SettingsFlags:
+        return cls(
+            settings=_normalize_source(settings) if settings and settings.strip() else None,
+            allowed_tools=_split_tool_names(allowed_tools),
+            disallowed_tools=_split_tool_names(disallowed_tools),
+            mcp_config=tuple(_normalize_source(value) for value in (mcp_config or ()) if value.strip()),
+        )
+
+    def is_empty(self) -> bool:
+        return not (self.settings or self.allowed_tools or self.disallowed_tools or self.mcp_config)
+
+    def to_overlay(self) -> SettingsOverlay:
+        """Parse and validate the flags. Raises ValueError with a flag-prefixed message."""
+        patch: dict[str, Any] | None = None
+        if self.settings:
+            patch = _load_json_object(self.settings, "--settings")
+            try:
+                Settings.model_validate(apply_json_merge_patch({}, patch))
+            except ValidationError as exc:
+                raise ValueError(f"--settings: invalid settings: {exc}") from exc
+
+        servers: dict[str, McpServerConfig] = {}
+        for value in self.mcp_config:
+            data = _load_json_object(value, "--mcp-config")
+            raw_servers = data.get("mcpServers", data.get("mcp_servers"))
+            if not isinstance(raw_servers, dict):
+                raise ValueError("--mcp-config: expected an object with an 'mcpServers' object")
+            for name, config in raw_servers.items():
+                try:
+                    servers[name] = _MCP_SERVER_ADAPTER.validate_python(config)
+                except ValidationError as exc:
+                    raise ValueError(f"--mcp-config: invalid server {name!r}: {exc}") from exc
+
+        return SettingsOverlay(
+            patch=patch,
+            allowed_tools=self.allowed_tools,
+            denied_tools=self.disallowed_tools,
+            mcp_servers=servers or None,
+        )
+
+
+__all__ = ["SettingsFlags"]
