-def load_settings(config_path: Path | None = None) -> Settings:
+def apply_json_merge_patch(target: Any, patch: Any) -> Any:
+    """Apply an RFC 7386 JSON Merge Patch and return the result.
+
+    Objects merge key by key, ``null`` removes a key, and any other value
+    (including a list) replaces the target value. ``target`` is not modified.
+    """
+    if not isinstance(patch, dict):
+        return patch
+    result = dict(target) if isinstance(target, dict) else {}
+    for key, value in patch.items():
+        if value is None:
+            result.pop(key, None)
+        else:
+            result[key] = apply_json_merge_patch(result.get(key), value)
+    return result
+
+
+def _dedupe(items: list[str]) -> list[str]:
+    return list(dict.fromkeys(items))
+
+
+@dataclass
+class SettingsOverlay:
+    """Process-local settings layered over settings.json by CLI flags.
+
+    ``patch`` (from ``--settings``) is a JSON Merge Patch applied to the raw
+    file contents before validation, so it behaves as if settings.json
+    contained it. ``allowed_tools`` / ``denied_tools`` extend the permission
+    lists, and ``mcp_servers`` (from ``--mcp-config``) add servers or replace
+    same-name ones. The overlay is never written back: code that saves
+    settings starts from a plain ``load_settings()``.
+    """
+
+    patch: dict[str, Any] | None = None
+    allowed_tools: tuple[str, ...] = ()
+    denied_tools: tuple[str, ...] = ()
+    mcp_servers: dict[str, McpServerConfig] | None = None
+
+    def is_empty(self) -> bool:
+        return not (self.patch or self.allowed_tools or self.denied_tools or self.mcp_servers)
+
+    def __bool__(self) -> bool:
+        return not self.is_empty()
+
+    def apply_after_load(self, settings: Settings) -> Settings:
+        """Apply the parts that are not a merge patch: tool lists and MCP servers."""
+        updates: dict[str, Any] = {}
+        if self.allowed_tools or self.denied_tools:
+            updates["permission"] = settings.permission.model_copy(
+                update={
+                    "allowed_tools": _dedupe([*settings.permission.allowed_tools, *self.allowed_tools]),
+                    "denied_tools": _dedupe([*settings.permission.denied_tools, *self.denied_tools]),
+                }
+            )
+        if self.mcp_servers:
+            updates["mcp_servers"] = {**settings.mcp_servers, **self.mcp_servers}
+        return settings.model_copy(update=updates) if updates else settings
+
+
+def load_settings(config_path: Path | None = None, overlay: SettingsOverlay | None = None) -> Settings:
     """Load settings from config file, merging with defaults.
 
     Args:
         config_path: Path to settings.json. If None, uses the default location.
+        overlay: Optional process-local overlay from CLI flags (see SettingsOverlay).
 
     Returns:
         Settings instance with file values merged over defaults.
@@ -1058,8 +1119,18 @@ def load_settings(config_path: Path | None = None) -> Settings:
 
         config_path = get_config_file_path()
 
-    if config_path.exists():
-        raw = json.loads(config_path.read_text(encoding="utf-8"))
+    if overlay is not None and overlay.is_empty():
+        overlay = None
+    settings = _load_settings_file(config_path, overlay.patch if overlay else None)
+    return overlay.apply_after_load(settings) if overlay else settings
+
+
+def _load_settings_file(config_path: Path, patch: dict[str, Any] | None) -> Settings:
+    raw = json.loads(config_path.read_text(encoding="utf-8")) if config_path.exists() else None
+    if patch:
+        raw = apply_json_merge_patch(raw or {}, patch)
+
+    if raw is not None:
         settings = Settings.model_validate(raw)
         env_profile = os.environ.get("OPENHARNESS_PROFILE")
         if env_profile:
