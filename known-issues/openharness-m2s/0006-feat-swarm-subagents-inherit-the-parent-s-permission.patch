index 0000000..c9fe4a1
--- /dev/null
+++ b/tests/test_swarm/test_teammate_permissions.py
@@ -0,0 +1,256 @@
+"""Subagents inherit the parent's permission overlay and their definition's limits."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from pathlib import Path
+
+import pytest
+from typer.testing import CliRunner
+
+import openharness.cli as cli
+from openharness.config.cli_overlay import SettingsFlags
+from openharness.config.settings import SettingsOverlay
+from openharness.coordinator.agent_definitions import (
+    AgentDefinition,
+    get_agent_definition,
+    normalize_tool_name,
+    resolve_agent_tool_denials,
+)
+from openharness.mcp.types import McpHttpServerConfig
+from openharness.swarm.spawn_utils import build_inherited_cli_flags, to_openharness_permission_mode
+from openharness.tasks.manager import BackgroundTaskManager
+from openharness.tasks.types import TaskRecord
+from openharness.tools import create_default_tool_registry
+from openharness.tools.agent_tool import AgentTool, AgentToolInput
+from openharness.tools.base import ToolExecutionContext
+
+
+def _parent_overlay() -> SettingsOverlay:
+    return SettingsOverlay(
+        patch={"permission": {"path_rules": [{"pattern": "*/coord/*", "allow": False}], "writable_paths": ["*/out/*"]}},
+        allowed_tools=("read_file",),
+        denied_tools=("web_fetch",),
+        mcp_servers={"m2s": McpHttpServerConfig(url="http://127.0.0.1:9/mcp/", headers={"X": "1"})},
+    )
+
+
+def _value(flags: list[str], flag: str) -> str:
+    return flags[flags.index(flag) + 1]
+
+
+# --- build_inherited_cli_flags ---
+
+
+def test_flag_values_are_passed_verbatim_for_direct_exec():
+    prompt = "You're the 'reviewer'; check $HOME and \"quotes\"."
+    flags = build_inherited_cli_flags(model="qwen-max", system_prompt=prompt)
+
+    assert _value(flags, "--system-prompt") == prompt
+    assert _value(flags, "--model") == "qwen-max"
+
+
+@pytest.mark.parametrize(
+    ("mode", "expected"),
+    [
+        ("bypassPermissions", "full_auto"),
+        ("dontAsk", "full_auto"),
+        ("acceptEdits", "default"),
+        ("default", "default"),
+        ("plan", "plan"),
+        ("full_auto", "full_auto"),
+        ("bogus", None),
+        (None, None),
+    ],
+)
+def test_permission_modes_map_to_openharness_modes(mode, expected):
+    assert to_openharness_permission_mode(mode) == expected
+    flags = build_inherited_cli_flags(permission_mode=mode)
+    if expected is None:
+        assert "--permission-mode" not in flags
+    else:
+        assert _value(flags, "--permission-mode") == expected
+
+
+def test_plan_mode_required_overrides_permission_mode():
+    flags = build_inherited_cli_flags(permission_mode="bypassPermissions", plan_mode_required=True)
+
+    assert _value(flags, "--permission-mode") == "plan"
+    assert "--dangerously-skip-permissions" not in flags
+
+
+def test_overlay_round_trips_through_cli_flags():
+    overlay = _parent_overlay()
+    flags = build_inherited_cli_flags(settings_overlay=overlay, settings_path="/ignored.json")
+
+    reparsed = SettingsFlags.from_cli(
+        settings=_value(flags, "--settings"),
+        allowed_tools=[_value(flags, "--allowed-tools")],
+        disallowed_tools=[_value(flags, "--disallowed-tools")],
+        mcp_config=[_value(flags, "--mcp-config")],
+    ).to_overlay()
+
+    assert flags.count("--settings") == 1
+    assert reparsed.patch == overlay.patch
+    assert reparsed.allowed_tools == overlay.allowed_tools
+    assert reparsed.denied_tools == overlay.denied_tools
+    assert reparsed.mcp_servers == overlay.mcp_servers
+
+
+def test_settings_path_used_when_overlay_has_no_patch():
+    flags = build_inherited_cli_flags(settings_overlay=SettingsOverlay(denied_tools=("bash",)), settings_path="/s.json")
+
+    assert _value(flags, "--settings") == "/s.json"
+    assert _value(flags, "--disallowed-tools") == "bash"
+
+
+# --- agent definition tool limits ---
+
+
+def test_definition_tool_names_are_normalized():
+    assert normalize_tool_name("Read") == "read_file"
+    assert normalize_tool_name("file_edit") == "edit_file"
+    assert normalize_tool_name("mcp__m2s-server__run_gate") == "mcp__m2s-server__run_gate"
+
+
+def test_allowlist_denies_every_other_available_tool():
+    available = [tool.name for tool in create_default_tool_registry().list_tools()]
+    guide = get_agent_definition("claude-code-guide")
+
+    denied = resolve_agent_tool_denials(guide, available)
+
+    assert {"glob", "grep", "read_file", "web_fetch", "web_search"}.isdisjoint(denied)
+    assert {"bash", "write_file", "edit_file", "agent"} <= set(denied)
+
+
+def test_disallowed_list_uses_registry_names():
+    available = [tool.name for tool in create_default_tool_registry().list_tools()]
+
+    denied = resolve_agent_tool_denials(get_agent_definition("Explore"), available)
+
+    assert {"agent", "exit_plan_mode", "edit_file", "write_file", "notebook_edit"} == set(denied)
+
+
+def test_unrestricted_definitions_deny_nothing():
+    available = ["bash", "read_file"]
+
+    assert resolve_agent_tool_denials(get_agent_definition("general-purpose"), available) == []
+    assert resolve_agent_tool_denials(AgentDefinition(name="m2s-architect", description="d"), available) == []
+
+
+# --- agent tool -> subprocess argv -> child CLI ---
+
+
+@pytest.fixture
+def captured_spawn(monkeypatch, tmp_path: Path) -> dict:
+    captured: dict = {}
+
+    async def _fake_create_agent_task(self, **kwargs):
+        captured.update(kwargs)
+        return TaskRecord(
+            id="task_perm",
+            type="local_agent",
+            status="running",
+            description=str(kwargs["description"]),
+            cwd=str(kwargs["cwd"]),
+            output_file=tmp_path / "task_perm.log",
+            argv=list(kwargs.get("argv") or []),
+        )
+
+    monkeypatch.setattr(BackgroundTaskManager, "create_agent_task", _fake_create_agent_task)
+    monkeypatch.setattr("openharness.swarm.subprocess_backend.get_teammate_command", lambda: "/usr/bin/python3")
+    return captured
+
+
+def _context(tmp_path: Path, **metadata) -> ToolExecutionContext:
+    return ToolExecutionContext(
+        cwd=tmp_path,
+        metadata={"tool_registry": create_default_tool_registry(), **metadata},
+    )
+
+
+def _child_cli_args(argv: list[str]) -> list[str]:
+    """The child's CLI arguments, independent of which interpreter path launches it."""
+    return argv[argv.index("--task-worker"):]
+
+
+def _run_child_cli(args: list[str], monkeypatch) -> dict:
+    captured: dict = {}
+
+    async def fake_run_task_worker(**kwargs):
+        captured.update(kwargs)
+
+    monkeypatch.setattr("openharness.ui.app.run_task_worker", fake_run_task_worker)
+    result = CliRunner().invoke(cli.app, args)
+    assert result.exit_code == 0, result.output
+    return captured
+
+
+def test_subagent_inherits_parent_overlay_and_mode(tmp_path: Path, captured_spawn, monkeypatch):
+    overlay = _parent_overlay()
+    context = _context(tmp_path, settings_overlay=overlay, permission_mode="plan")
+
+    result = asyncio.run(AgentTool().execute(AgentToolInput(description="d", prompt="do it"), context))
+
+    assert result.is_error is False
+    child = _run_child_cli(_child_cli_args(captured_spawn["argv"]), monkeypatch)
+    assert child["permission_mode"] == "plan"
+    child_overlay = child["settings_overlay"]
+    assert child_overlay.patch == overlay.patch
+    assert child_overlay.denied_tools == ("web_fetch",)
+    assert set(child_overlay.mcp_servers) == {"m2s"}
