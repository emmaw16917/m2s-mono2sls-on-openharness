+#: Claude Code tool names (and a few legacy snake_case spellings used in the
+#: built-in definitions) -> OpenHarness registry names.
+_TOOL_NAME_ALIASES = {
+    "Read": "read_file",
+    "Write": "write_file",
+    "Edit": "edit_file",
+    "MultiEdit": "edit_file",
+    "Glob": "glob",
+    "Grep": "grep",
+    "Bash": "bash",
+    "WebFetch": "web_fetch",
+    "WebSearch": "web_search",
+    "NotebookEdit": "notebook_edit",
+    "Agent": "agent",
+    "Task": "agent",
+    "TodoWrite": "todo_write",
+    "EnterPlanMode": "enter_plan_mode",
+    "ExitPlanMode": "exit_plan_mode",
+    "AskUserQuestion": "ask_user_question",
+    "Skill": "skill",
+    "ToolSearch": "tool_search",
+    "SendMessage": "send_message",
+    "file_read": "read_file",
+    "file_write": "write_file",
+    "file_edit": "edit_file",
+}
+
+
+def normalize_tool_name(name: str) -> str:
+    """Map an agent-definition tool name to the OpenHarness registry name."""
+    return _TOOL_NAME_ALIASES.get(name, name)
+
+
+def resolve_agent_tool_denials(agent: AgentDefinition, available_tools: list[str]) -> list[str]:
+    """Tool names an agent may not use: its ``disallowed_tools`` plus, when
+    ``tools`` is an allowlist, every available tool not on it."""
+    denied = [normalize_tool_name(name) for name in agent.disallowed_tools or []]
+    if agent.tools is not None and "*" not in agent.tools:
+        allowed = {normalize_tool_name(name) for name in agent.tools}
+        denied.extend(name for name in available_tools if name not in allowed)
+    return list(dict.fromkeys(denied))
+
+
 def get_agent_definition(name: str) -> AgentDefinition | None:
     """Return the agent definition for *name*, or ``None`` if not found."""
     for agent in get_all_agent_definitions():
