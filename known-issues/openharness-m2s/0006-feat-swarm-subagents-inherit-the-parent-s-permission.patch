--- a/src/openharness/config/settings.py
+++ b/src/openharness/config/settings.py
@@ -1099,6 +1099,23 @@ class SettingsOverlay:
     def __bool__(self) -> bool:
         return not self.is_empty()
 
+    def to_cli_args(self) -> list[str]:
+        """The CLI flags that rebuild this overlay in a child process (argv form)."""
+        args: list[str] = []
+        if self.patch:
+            args.extend(["--settings", json.dumps(self.patch)])
+        for name in self.allowed_tools:
+            args.extend(["--allowed-tools", name])
+        for name in self.denied_tools:
+            args.extend(["--disallowed-tools", name])
+        if self.mcp_servers:
+            servers = {
+                name: config.model_dump(mode="json", exclude_none=True)
+                for name, config in self.mcp_servers.items()
+            }
+            args.extend(["--mcp-config", json.dumps({"mcpServers": servers})])
+        return args
+
     def apply_after_load(self, settings: Settings) -> Settings:
         """Apply the parts that are not a merge patch: tool lists and MCP servers."""
         updates: dict[str, Any] = {}
