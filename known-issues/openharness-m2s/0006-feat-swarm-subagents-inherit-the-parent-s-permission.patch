+def test_subagent_applies_definition_limits_on_top(tmp_path: Path, captured_spawn, monkeypatch):
+    context = _context(tmp_path, settings_overlay=_parent_overlay(), permission_mode="default")
+
+    result = asyncio.run(
+        AgentTool().execute(
+            AgentToolInput(description="d", prompt="look around", subagent_type="claude-code-guide"), context
+        )
+    )
+
+    assert result.is_error is False
+    child = _run_child_cli(_child_cli_args(captured_spawn["argv"]), monkeypatch)
+    # The definition's own mode (dontAsk) wins over the parent's.
+    assert child["permission_mode"] == "full_auto"
+    denied = set(child["settings_overlay"].denied_tools)
+    assert {"web_fetch", "bash", "write_file", "edit_file", "agent"} <= denied
+    assert "read_file" not in denied
+    # The parent's path rules still travel with the child.
+    assert child["settings_overlay"].patch["permission"]["path_rules"][0]["pattern"] == "*/coord/*"
