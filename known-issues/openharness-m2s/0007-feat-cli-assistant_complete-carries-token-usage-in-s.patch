From e4eb3f02a3443061cbc7568e99f93f6a60fb2338 Mon Sep 17 00:00:00 2001
From: Wang Emma <wangzhn>
Date: Mon, 16 Nov 2026 20:43:16 +0800
Subject: [PATCH 7/7] feat(cli): assistant_complete carries token usage in
 stream-json mode

The dispatcher's run report sums usage per task from the worker stream
(M4/W2.10); older streams without usage contribute 0. One test drives
run_print_mode with a fake runtime and a UsageSnapshot.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 src/openharness/ui/app.py            |  5 +++-
 tests/test_ui/test_react_launcher.py | 40 ++++++++++++++++++++++++++++
 2 files changed, 44 insertions(+), 1 deletion(-)

diff --git a/src/openharness/ui/app.py b/src/openharness/ui/app.py
index 60b980b..537770e 100644
--- a/src/openharness/ui/app.py
+++ b/src/openharness/ui/app.py
@@ -289,7 +289,10 @@ async def run_print_mode(
                     sys.stdout.write("\n")
                     sys.stdout.flush()
                 elif output_format == "stream-json":
-                    obj = {"type": "assistant_complete", "text": event.message.text.strip()}
+                    usage = getattr(event, "usage", None)
+                    obj = {"type": "assistant_complete", "text": event.message.text.strip(),
+                           "usage": {"input_tokens": int(getattr(usage, "input_tokens", 0) or 0),
+                                     "output_tokens": int(getattr(usage, "output_tokens", 0) or 0)}}
                     print(json.dumps(obj), flush=True)
                     events_list.append(obj)
             elif isinstance(event, ToolExecutionStarted):
diff --git a/tests/test_ui/test_react_launcher.py b/tests/test_ui/test_react_launcher.py
index 0b7f199..c851176 100644
--- a/tests/test_ui/test_react_launcher.py
+++ b/tests/test_ui/test_react_launcher.py
@@ -306,3 +306,43 @@ async def test_run_print_mode_waits_for_coordinator_async_agents(monkeypatch):
     assert "&lt;ready&gt;" in engine.messages[1].text
     assert "worker@default" in engine.messages[1].text
     assert saved_snapshots
+
+
+@pytest.mark.asyncio
+async def test_print_stream_records_token_usage(monkeypatch, capsys):
+    """M4/W2.10: assistant_complete carries the provider's usage so the
+    dispatcher can report tokens per task (the run report reads this)."""
+    import json
+
+    from openharness.api.usage import UsageSnapshot
+
+    async def _build_runtime(**kwargs):
+        return SimpleNamespace(
+            app_state=SimpleNamespace(get=lambda: None),
+            mcp_manager=SimpleNamespace(list_statuses=lambda: []),
+            commands=SimpleNamespace(list_commands=lambda: []),
+            events=_AsyncIterator(),
+        )
+
+    async def _start_runtime(_bundle):
+        return None
+
+    async def _close_runtime(_bundle):
+        return None
+
+    async def _handle_line(bundle, prompt, *, print_system, render_event, clear_output):
+        await render_event(AssistantTurnComplete(
+            message=ConversationMessage(role="assistant", content=[TextBlock(text="hello")]),
+            usage=UsageSnapshot(input_tokens=12, output_tokens=3)))
+
+    monkeypatch.setattr("openharness.ui.app.build_runtime", _build_runtime)
+    monkeypatch.setattr("openharness.ui.app.start_runtime", _start_runtime)
+    monkeypatch.setattr("openharness.ui.app.handle_line", _handle_line)
+    monkeypatch.setattr("openharness.ui.app.close_runtime", _close_runtime)
+
+    await run_print_mode(prompt="hi", output_format="stream-json")
+
+    events = [json.loads(line) for line in capsys.readouterr().out.splitlines() if line.strip()]
+    done = [e for e in events if e.get("type") == "assistant_complete"]
+    assert done == [{"type": "assistant_complete", "text": "hello",
+                     "usage": {"input_tokens": 12, "output_tokens": 3}}]
