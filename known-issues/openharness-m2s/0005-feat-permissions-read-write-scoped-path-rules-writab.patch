diff --git a/tests/test_permissions/test_checker_access.py b/tests/test_permissions/test_checker_access.py
new file mode 100644
index 0000000..b9e62a9
--- /dev/null
+++ b/tests/test_permissions/test_checker_access.py
@@ -0,0 +1,202 @@
+"""Read/write-scoped path rules, writable_paths, and deny-before-allow ordering."""
+
+from __future__ import annotations
+
+import logging
+from pathlib import Path
+
+import pytest
+
+from openharness.config.settings import PathRuleConfig, PermissionSettings
+from openharness.engine.query import QueryContext, _execute_tool_call
+from openharness.permissions import PermissionChecker, PermissionMode
+from openharness.tools.base import ToolRegistry
+from openharness.tools.file_read_tool import FileReadTool
+from openharness.tools.file_write_tool import FileWriteTool
+
+
+def _checker(**kwargs) -> PermissionChecker:
+    kwargs.setdefault("mode", PermissionMode.FULL_AUTO)
+    return PermissionChecker(PermissionSettings(**kwargs))
+
+
+# --- access-scoped path rules ---
+
+
+def test_read_rule_blocks_reads_but_not_writes():
+    checker = _checker(path_rules=[PathRuleConfig(pattern="*/verification/*", allow=False, access="read")])
+
+    assert not checker.evaluate("read_file", is_read_only=True, file_path="/ws/verification/plan.json").allowed
+    assert checker.evaluate("write_file", is_read_only=False, file_path="/ws/verification/plan.json").allowed
+
+
+def test_write_rule_keeps_path_readable():
+    """E.g. the frozen judge: readable by the implementation line, never writable."""
+    checker = _checker(path_rules=[PathRuleConfig(pattern="*/judge/*", allow=False, access="write")])
+
+    assert checker.evaluate("read_file", is_read_only=True, file_path="/ws/judge/cases.json").allowed
+    decision = checker.evaluate("edit_file", is_read_only=False, file_path="/ws/judge/cases.json")
+    assert not decision.allowed
+    assert "deny rule (write)" in decision.reason
+
+
+def test_rule_without_access_applies_to_both():
+    checker = _checker(path_rules=[PathRuleConfig(pattern="*/coord/*", allow=False)])
+
+    assert PathRuleConfig(pattern="x").access == "any"
+    assert not checker.evaluate("read_file", is_read_only=True, file_path="/ws/coord/events.jsonl").allowed
+    assert not checker.evaluate("write_file", is_read_only=False, file_path="/ws/coord/events.jsonl").allowed
+
+
+def test_unknown_access_fails_closed(caplog):
+    rule = PathRuleConfig.model_construct(pattern="*/coord/*", allow=False, access="sometimes")
+    settings = PermissionSettings.model_construct(
+        mode=PermissionMode.FULL_AUTO, allowed_tools=[], denied_tools=[], denied_commands=[], path_rules=[rule]
+    )
+
+    with caplog.at_level(logging.WARNING, logger="openharness.permissions.checker"):
+        checker = PermissionChecker(settings)
+
+    assert "unknown access" in caplog.text
+    assert not checker.evaluate("read_file", is_read_only=True, file_path="/ws/coord/x").allowed
+    assert not checker.evaluate("write_file", is_read_only=False, file_path="/ws/coord/x").allowed
+
+
+def test_access_value_is_validated_in_settings():
+    with pytest.raises(ValueError):
+        PathRuleConfig(pattern="*", allow=False, access="sometimes")
+
+
+# --- deny rules win over allowed_tools ---
+
+
+def test_allowed_tools_cannot_bypass_path_rules():
+    checker = _checker(
+        mode=PermissionMode.DEFAULT,
+        allowed_tools=["read_file"],
+        path_rules=[PathRuleConfig(pattern="*/coord/*", allow=False)],
+    )
+
+    assert not checker.evaluate("read_file", is_read_only=True, file_path="/ws/coord/events.jsonl").allowed
+
+
+def test_allowed_tools_cannot_bypass_denied_commands():
+    checker = _checker(mode=PermissionMode.DEFAULT, allowed_tools=["bash"], denied_commands=["*coord*"])
+
+    assert not checker.evaluate("bash", is_read_only=False, command="cat coord/events.jsonl").allowed
+
+
+def test_allowed_tools_cannot_bypass_writable_paths():
+    checker = _checker(mode=PermissionMode.DEFAULT, allowed_tools=["write_file"], writable_paths=["*/output/*"])
+
+    assert not checker.evaluate("write_file", is_read_only=False, file_path="/ws/storage/x.json").allowed
+
+
+def test_allowed_tools_still_skip_confirmation_when_no_rule_matches():
+    checker = _checker(
+        mode=PermissionMode.DEFAULT,
+        allowed_tools=["bash"],
+        denied_commands=["*coord*"],
+        path_rules=[PathRuleConfig(pattern="*/coord/*", allow=False)],
+    )
+
+    decision = checker.evaluate("bash", is_read_only=False, command="npm test")
+    assert decision.allowed
+    assert decision.requires_confirmation is False
+
+
+# --- writable_paths ---
+
+
+@pytest.fixture
+def scoped_checker() -> PermissionChecker:
+    return _checker(writable_paths=["*/output/lambdas/flights/*", "*/storage/stage_reports/S2-flights*"])
+
+
+def test_writes_inside_writable_paths_are_allowed(scoped_checker):
+    assert scoped_checker.evaluate(
+        "write_file", is_read_only=False, file_path="/ws/output/lambdas/flights/search/handler.js"
+    ).allowed
+    assert scoped_checker.evaluate(
+        "write_file", is_read_only=False, file_path="/ws/storage/stage_reports/S2-flights.json"
+    ).allowed
+
+
+def test_writes_outside_writable_paths_are_denied(scoped_checker):
+    decision = scoped_checker.evaluate("edit_file", is_read_only=False, file_path="/ws/output/lambdas/orders/h.js")
+
+    assert not decision.allowed
+    assert "outside the writable paths" in decision.reason
+
+
+def test_writable_paths_do_not_limit_reads(scoped_checker):
+    assert scoped_checker.evaluate("read_file", is_read_only=True, file_path="/ws/output/lambdas/orders/h.js").allowed
+
+
+def test_writable_paths_skip_mcp_tools_and_pathless_tools(scoped_checker):
+    # MCP tools often take a non-file "path" (e.g. an HTTP route); their server owns its writes.
+    assert scoped_checker.evaluate(
+        "mcp__m2s-server__annotate_entry_point", is_read_only=False, file_path="/flights/search"
+    ).allowed
+    assert scoped_checker.evaluate("bash", is_read_only=False, command="npm test").allowed
+
+
+def test_empty_writable_paths_means_no_restriction():
+    assert _checker().evaluate("write_file", is_read_only=False, file_path="/anywhere/x").allowed
+
+
+# --- through the query engine with real file tools ---
+
+
+def _context(tmp_path: Path, settings: PermissionSettings) -> QueryContext:
+    class _NoopApiClient:
+        async def stream_message(self, request):
+            del request
+            if False:
+                yield None
+
+    registry = ToolRegistry()
+    registry.register(FileReadTool())
+    registry.register(FileWriteTool())
+    return QueryContext(
+        api_client=_NoopApiClient(),
+        tool_registry=registry,
+        permission_checker=PermissionChecker(settings),
+        cwd=tmp_path,
+        model="claude-test",
+        system_prompt="system",
+        max_tokens=1,
+        max_turns=1,
+    )
+
+
+@pytest.mark.asyncio
+async def test_engine_enforces_writable_paths_and_write_only_rules(tmp_path: Path):
+    (tmp_path / "judge").mkdir()
+    (tmp_path / "judge" / "cases.json").write_text('{"frozen": true}\n', encoding="utf-8")
+    context = _context(
+        tmp_path,
+        PermissionSettings(
+            mode=PermissionMode.FULL_AUTO,
+            allowed_tools=["write_file"],  # must not bypass the rules below
+            path_rules=[PathRuleConfig(pattern="*/judge/*", allow=False, access="write")],
+            writable_paths=["*/output/*"],
+        ),
+    )
+
+    inside = await _execute_tool_call(
+        context, "write_file", "t1", {"path": "output/flights/handler.js", "content": "ok\n"}
+    )
+    outside = await _execute_tool_call(context, "write_file", "t2", {"path": "storage/x.json", "content": "no\n"})
+    judge_write = await _execute_tool_call(
+        context, "write_file", "t3", {"path": "judge/cases.json", "content": "tampered\n"}
+    )
+    judge_read = await _execute_tool_call(context, "read_file", "t4", {"path": "judge/cases.json"})
+
+    assert inside.is_error is False
+    assert (tmp_path / "output" / "flights" / "handler.js").read_text(encoding="utf-8") == "ok\n"
+    assert outside.is_error is True and "outside the writable paths" in outside.content
+    assert not (tmp_path / "storage" / "x.json").exists()
+    assert judge_write.is_error is True
+    assert (tmp_path / "judge" / "cases.json").read_text(encoding="utf-8") == '{"frozen": true}\n'
+    assert judge_read.is_error is False and "frozen" in judge_read.content
