-                        if not rule.allow:
-                            return PermissionDecision(
-                                allowed=False,
-                                reason=f"Path {file_path} matches deny rule: {rule.pattern}",
-                            )
+                        scope = "" if rule.access == "any" else f" ({rule.access})"
+                        return PermissionDecision(
+                            allowed=False,
+                            reason=f"Path {file_path} matches deny rule{scope}: {rule.pattern}",
+                        )
+
+        # Writable-path allowlist for built-in tools that modify files
+        if (
+            file_path
+            and self._writable_paths
+            and not is_read_only
+            and not tool_name.startswith(_MCP_TOOL_PREFIX)
+            and not any(
+                fnmatch.fnmatch(candidate_path, pattern)
+                for candidate_path in _policy_match_paths(file_path)
+                for pattern in self._writable_paths
+            )
+        ):
+            return PermissionDecision(
+                allowed=False,
+                reason=f"Path {file_path} is outside the writable paths: {', '.join(self._writable_paths)}",
+            )
 
