From 7a0402674bcef9f7d53d6c7c30d24e8d2608c15a Mon Sep 17 00:00:00 2001
From: Wang Emma <wangzhn>
Date: Sun, 27 Sep 2026 16:48:45 +0800
Subject: [PATCH 2/7] fix(api): retry transient transport errors in the
 OpenAI-compatible client

Long multi-agent runs were ended by a single transient failure that
_is_retryable did not recognise:

- openai.APIConnectionError / APITimeoutError and httpx.TransportError
  (e.g. RemoteProtocolError "incomplete chunked read") are not OSError
  subclasses, so a dropped stream or "Request timed out" was fatal;
- a raw httpcore.ReadError('') can escape mid-stream, and httpcore's
  exceptions are not httpx subclasses;
- DashScope returned sporadic 403 AccessDenied.Unpurchased while a
  re-enabled model entitlement propagated (a revoked one still fails
  after the bounded retries; other 403s are not retried).

The retry budget is raised to 8 retries with the delay capped at 60s
(~3 minutes in total, previously ~7s) so a network outage of a few
minutes no longer kills the session.

Exceptions that stringify to "" surfaced as a bare "API error:"; the
error text now includes the exception type (and cause in run_query).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/openharness/api/openai_client.py | 39 +++++++++++++++++++++++++---
 src/openharness/engine/query.py      |  4 ++-
 tests/test_api/test_openai_client.py | 39 ++++++++++++++++++++++++++++
 3 files changed, 78 insertions(+), 4 deletions(-)

diff --git a/src/openharness/api/openai_client.py b/src/openharness/api/openai_client.py
index 45a5bc8..178db3d 100644
--- a/src/openharness/api/openai_client.py
+++ b/src/openharness/api/openai_client.py
@@ -37,9 +37,12 @@ from openharness.engine.messages import (
 
 log = logging.getLogger(__name__)
 
-MAX_RETRIES = 3
+# 8 retries with the delay capped at 60s back off 1+2+4+8+16+32+60+60 s,
+# about 3 minutes, so a network outage of a few minutes does not end a long
+# multi-agent run (3 retries covered only ~7s).
+MAX_RETRIES = 8
 BASE_DELAY = 1.0
-MAX_DELAY = 30.0
+MAX_DELAY = 60.0
 _MAX_COMPLETION_TOKEN_MODEL_PREFIXES = ("gpt-5", "o1", "o3", "o4")
 
 
@@ -438,14 +441,44 @@ class OpenAICompatibleClient:
         status = getattr(exc, "status_code", None)
         if status and status in {429, 500, 502, 503}:
             return True
+        # DashScope returned sporadic 403 AccessDenied.Unpurchased while a
+        # re-enabled model entitlement was propagating (most calls already
+        # succeeded). Retry that specific code with the normal bounded backoff;
+        # a genuinely revoked entitlement still fails after the retries.
+        if status == 403 and "AccessDenied.Unpurchased" in str(exc):
+            return True
         if isinstance(exc, (ConnectionError, TimeoutError, OSError)):
             return True
+        # The openai SDK's connection/timeout errors and raw httpx transport
+        # errors are not OSError subclasses, so without this a dropped stream
+        # ("peer closed connection without sending complete message body
+        # (incomplete chunked read)", httpx.RemoteProtocolError) or "Request
+        # timed out" (openai.APITimeoutError) ended the whole agent session on
+        # the first occurrence instead of being retried.
+        try:
+            import httpx
+            import openai
+
+            if isinstance(exc, (openai.APIConnectionError, httpx.TransportError)):
+                return True
+        except ImportError:
+            pass
+        # httpcore's own exceptions are not httpx subclasses, and a dropped
+        # stream can surface as a raw httpcore.ReadError('') mid-iteration
+        # (seen: "API error: ReadError: ReadError('')" ended a run).
+        try:
+            import httpcore
+
+            if isinstance(exc, (httpcore.NetworkError, httpcore.TimeoutException, httpcore.ProtocolError)):
+                return True
+        except ImportError:
+            pass
         return False
 
     @staticmethod
     def _translate_error(exc: Exception) -> OpenHarnessApiError:
         status = getattr(exc, "status_code", None)
-        msg = str(exc)
+        msg = str(exc) or f"{type(exc).__name__}: {exc!r}"
         if status == 401 or status == 403:
             return AuthenticationFailure(msg)
         if status == 429:
diff --git a/src/openharness/engine/query.py b/src/openharness/engine/query.py
index bc47515..6ea99dd 100644
--- a/src/openharness/engine/query.py
+++ b/src/openharness/engine/query.py
@@ -751,7 +751,9 @@ async def run_query(
                     final_message = event.message
                     usage = event.usage
         except Exception as exc:
-            error_msg = str(exc)
+            # Some exceptions stringify to "" (seen as a bare "API error:" that
+            # ended a long run); include the type and cause so it can be diagnosed.
+            error_msg = str(exc) or f"{type(exc).__name__}: {exc!r} (cause: {exc.__cause__!r})"
             if _is_completion_token_limit_error(exc):
                 supported_limit = _extract_completion_token_limit(exc)
                 if supported_limit is not None and effective_max_tokens > supported_limit:
diff --git a/tests/test_api/test_openai_client.py b/tests/test_api/test_openai_client.py
index 299d7cc..ed51f85 100644
--- a/tests/test_api/test_openai_client.py
+++ b/tests/test_api/test_openai_client.py
@@ -497,3 +497,42 @@ class TestReasoningContentEmission:
         msg = ConversationMessage(role="assistant", content=[TextBlock(text="hi")])
         out = _convert_assistant_message(msg)
         assert "reasoning_content" not in out
+
+
+class TestRetryClassification:
+    """Transient transport failures are retried; auth and client errors are not."""
+
+    @staticmethod
+    def _status_error(status: int, message: str) -> Exception:
+        exc = Exception(message)
+        exc.status_code = status
+        return exc
+
+    def test_dropped_stream_is_retryable(self):
+        import httpcore
+
+        request = httpx.Request("POST", "https://example.invalid/v1/chat/completions")
+        assert OpenAICompatibleClient._is_retryable(
+            httpx.RemoteProtocolError("incomplete chunked read", request=request)
+        )
+        assert OpenAICompatibleClient._is_retryable(httpcore.ReadError(""))
+
+    def test_openai_connection_errors_are_retryable(self):
+        import openai
+
+        request = httpx.Request("POST", "https://example.invalid/v1/chat/completions")
+        assert OpenAICompatibleClient._is_retryable(openai.APITimeoutError(request=request))
+        assert OpenAICompatibleClient._is_retryable(openai.APIConnectionError(request=request))
+
+    def test_only_unpurchased_403_is_retryable(self):
+        assert OpenAICompatibleClient._is_retryable(
+            self._status_error(403, "Error code: 403 - AccessDenied.Unpurchased")
+        )
+        assert not OpenAICompatibleClient._is_retryable(self._status_error(403, "Forbidden"))
+        assert not OpenAICompatibleClient._is_retryable(self._status_error(400, "bad request"))
+
+    def test_empty_message_keeps_exception_type(self):
+        import httpcore
+
+        err = OpenAICompatibleClient._translate_error(httpcore.ReadError(""))
+        assert "ReadError" in str(err)
