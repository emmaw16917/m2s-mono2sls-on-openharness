+    # The task-manager parent always writes this worker's stdin as UTF-8
+    # bytes (see tasks/manager.py:_encode_task_worker_payload). Python's
+    # default text-mode stdin encoding follows the OS locale/codepage
+    # instead (e.g. GBK/cp936 on a Chinese-locale Windows machine), so a
+    # plain sys.stdin.readline() silently mis-decodes any non-ASCII byte,
+    # producing lone surrogates that later blow up as UnicodeEncodeError
+    # once that text is re-serialized. This worker only ever runs as a
+    # headless subprocess (see docstring above), never attached to a real
+    # interactive console, so forcing UTF-8 here is always correct.
+    try:
+        sys.stdin.reconfigure(encoding="utf-8", errors="strict")
+    except (AttributeError, ValueError):
+        pass
